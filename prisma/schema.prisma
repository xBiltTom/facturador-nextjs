// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== AUTENTICACIÓN Y USUARIOS =====
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String // Hash de la contraseña
  name          String
  phone         String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relación con la empresa
  company       Company?
  
  @@map("users")
}

// ===== EMPRESA =====
model Company {
  id                String   @id @default(cuid())
  businessName      String   // Razón social
  tradeName         String?  // Nombre comercial
  ruc               String   @unique
  address           String
  phone             String
  email             String
  logo              String?  // URL o path del logo de la empresa
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relación uno a uno con el usuario
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Relaciones con datos de la empresa
  categories        Category[]
  units             Unit[]
  products          Product[]
  customers         Customer[]
  sales             Sale[]
  
  @@map("companies")
}

// ===== CATEGORÍAS =====
model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  products    Product[]
  
  @@unique([companyId, name]) // No permitir categorías duplicadas por empresa
  @@map("categories")
}

// ===== UNIDADES DE MEDIDA =====
model Unit {
  id           String    @id @default(cuid())
  name         String    // Ej: Unidad, Kilogramo, Metro, Litro
  abbreviation String    // Ej: UND, KG, M, L
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  products     Product[]
  
  @@unique([companyId, name])
  @@map("units")
}

// ===== PRODUCTOS =====
model Product {
  id          String    @id @default(cuid())
  code        String    // Código interno del producto
  name        String
  description String?
  price       Decimal   @db.Decimal(10, 2)
  stock       Int       @default(0)
  minStock    Int       @default(0) // Stock mínimo para alertas
  image       String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  unitId      String
  unit        Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  
  saleDetails SaleDetail[]
  
  @@unique([companyId, code])
  @@map("products")
}

// ===== CLIENTES =====
model Customer {
  id              String       @id @default(cuid())
  customerType    CustomerType // NATURAL o JURIDICO
  
  // Datos para persona natural
  firstName       String?
  lastName        String?
  dni             String?      // DNI para personas naturales
  
  // Datos para persona jurídica
  businessName    String?      // Razón social
  ruc             String?      // RUC para personas jurídicas
  
  // Datos comunes
  email           String
  phone           String?
  address         String?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  sales           Sale[]
  
  @@unique([companyId, email])
  @@map("customers")
}

enum CustomerType {
  NATURAL   // Persona natural (Boleta)
  JURIDICO  // Persona jurídica (Factura)
}

// ===== VENTAS =====
model Sale {
  id              String         @id @default(cuid())
  saleNumber      String         // Número de venta consecutivo
  documentType    DocumentType   // FACTURA o BOLETA
  documentNumber  String         // Número del documento (B001-00001, F001-00001)
  saleDate        DateTime       @default(now())
  
  // Totales
  subtotal        Decimal        @db.Decimal(10, 2)
  igv             Decimal        @db.Decimal(10, 2) // 18% en Perú
  total           Decimal        @db.Decimal(10, 2)
  
  // Estado
  status          SaleStatus     @default(PENDING)
  paymentMethod   PaymentMethod?
  
  // Email
  emailSent       Boolean        @default(false)
  emailSentAt     DateTime?
  
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  saleDetails     SaleDetail[]
  
  @@unique([companyId, documentNumber])
  @@map("sales")
}

enum DocumentType {
  FACTURA
  BOLETA
}

enum SaleStatus {
  PENDING   // Pendiente
  PAID      // Pagada
  CANCELLED // Anulada
}

enum PaymentMethod {
  CASH         // Efectivo
  CARD         // Tarjeta
  TRANSFER     // Transferencia
  YAPE         // Yape
  PLIN         // Plin
}

// ===== DETALLE DE VENTA =====
model SaleDetail {
  id          String   @id @default(cuid())
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2) // Descuento por producto
  subtotal    Decimal  @db.Decimal(10, 2)
  
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  createdAt   DateTime @default(now())
  
  @@map("sale_details")
}